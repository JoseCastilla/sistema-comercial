# CRM MVP aislado (SPEC-062). Copia a apps/crm/.env. Ningún valor real aquí.
DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5433/crm_local
BETTER_AUTH_URL=http://localhost:3200
BETTER_AUTH_SECRET=cambia-esto-por-32-bytes-aleatorios
# AES-256-GCM (64 hex) para cifrar tokens de Meta.
CRM_ENCRYPTION_KEY=
# App de Meta (Embedded Signup y firma de webhooks).
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v24.0
# Token que verifica el webhook (GET hub.verify_token). Elige uno y ponlo igual en Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Proveedor de IA (agente conversacional).
ANTHROPIC_API_KEY=
# Carpeta de adjuntos.
CRM_STORAGE_DIR=./storage
NODE_ENV=development
# Tipo de cambio para mostrar costos de IA y difusiones en soles.
AI_USD_TO_PEN=3.7
BROADCAST_USD_TO_PEN=3.7
