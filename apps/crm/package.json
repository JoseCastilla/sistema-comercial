{
  "name": "crm",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -p 3200",
    "build": "prisma generate && next build",
    "start": "next start -p 3200",
    "lint": "eslint --max-warnings 0",
    "test": "prisma generate && vitest run",
    "check-types": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node scripts/guard-crm-database.mjs && prisma migrate dev",
    "db:migrate:deploy": "node scripts/guard-crm-database.mjs && prisma migrate deploy",
    "db:reset": "node scripts/guard-crm-database.mjs && prisma migrate reset --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@better-auth/prisma-adapter": "1.6.25",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@repo/ui": "*",
    "better-auth": "1.6.25",
    "next": "16.2.0",
    "pg": "8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/pg": "8.20.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "17.4.2",
    "eslint": "^9.39.1",
    "postcss": "^8.4.31",
    "prisma": "7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
