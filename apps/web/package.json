{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "auth:create-initial-admin": "pnpm --filter @repo/database run build && node scripts/create-initial-admin.mjs",
    "format": "prettier --write src scripts package.json tsconfig.json",
    "dev": "next dev -p 3100"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@repo/database": "workspace:*",
    "@repo/ui": "*",
    "@repo/validation": "workspace:*",
    "better-auth": "1.6.25",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
