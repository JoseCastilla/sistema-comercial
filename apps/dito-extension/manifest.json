{
  "manifest_version": 3,
  "name": "Sistema Comercial - Ventas DITO",
  "version": "2.1.2",
  "description": "Extrae y envía órdenes DITO al Sistema Comercial.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["scripting", "activeTab", "clipboardWrite", "storage"],
  "host_permissions": [
    "https://ventas.movistar.com.pe/*",
    "https://automatizaciones.distribuidoronline.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
