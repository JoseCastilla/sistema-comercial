# Variables del Sistema Comercial (SPEC-046 BR-006). Copia este archivo a
# `apps/web/.env.local`, `apps/api/.env` y `packages/database/.env` según el
# servicio, y en EasyPanel a cada servicio. Ningún valor real vive aquí.

# --- Base de datos (todos los servicios) ---
DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5433/sistema_comercial

# --- Web (Next.js) ---
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=cambia-esto-por-32-bytes-aleatorios
# Clave de cifrado de las acciones de servidor; en Docker viaja como ARG de build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# URL interna del API (no 127.0.0.1 en producción: incidente del 01/09/2026).
DITO_IMPORT_API_URL=http://localhost:3001
# Secretos compartidos web ↔ api (mismo valor en los dos servicios).
DITO_IMPORT_INTERNAL_SECRET=
RECOVERY_BASE_INTERNAL_SECRET=
# Clave AES-256-GCM (64 hex) para la cookie de Máximo/AGR.
AGR_DELIVERY_ENCRYPTION_KEY=
# Proveedor RENIEC.
DNI_LOOKUP_API_URL=
DNI_LOOKUP_API_TOKEN=

# --- API (NestJS) ---
HOST=0.0.0.0
PORT=3001
DITO_WEBHOOK_SECRET=
DITO_WEBHOOK_ORGANIZATION_SLUG=distribuidor-online
APP_VERSION=
BUSINESS_TIMEZONE=America/Lima

# --- Mantenimiento (web, api y worker; mismo secreto en los tres) ---
MAINTENANCE_INTERNAL_SECRET=
# Solo el worker: a dónde llama.
WEB_INTERNAL_URL=http://web:3000
API_INTERNAL_URL=http://api:3001
MAINTENANCE_INTERVAL_MINUTES=5

# --- Copia de seguridad (servicio infra/backup) ---
BACKUP_HOUR=03
BACKUP_RETENTION_DAYS=14

# --- Semilla (solo `prisma db seed`) ---
SEED_ORGANIZATION_NAME=
SEED_ORGANIZATION_SLUG=
SEED_ORGANIZATION_TIMEZONE=America/Lima
SEED_GHL_LOCATION_ID=
SEED_GHL_LOCATION_NAME=
SEED_GHL_WEBHOOK_SECRET=
SEED_GHL_COMPANY_ID=

NODE_ENV=development
