{
    "name":  "@repo/database",
    "version":  "0.0.0",
    "private":  true,
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          }
                },
    "scripts":  {
                    "db:generate":  "prisma generate",
                    "db:migrate:dev":  "prisma migrate dev",
                    "db:migrate:deploy":  "prisma migrate deploy",
                    "db:migrate:status":  "prisma migrate status",
                    "db:studio":  "prisma studio",
                    "db:check":  "node scripts/check-connection.mjs",
                    "build":  "pnpm run db:generate \u0026\u0026 tsc -p tsconfig.build.json",
                    "check-types":  "pnpm run db:generate \u0026\u0026 tsc --noEmit \u0026\u0026 pnpm run check-seed",
                    "lint":  "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" \"prisma/**/*.ts\" --ignore-pattern \"src/generated/**\" --max-warnings 0",
                    "db:seed":  "prisma db seed",
                    "check-seed":  "tsc -p tsconfig.seed.json --noEmit"
                },
    "dependencies":  {
                         "@prisma/adapter-pg":  "7.9.1",
                         "@prisma/client":  "7.9.1",
                         "dotenv":  "17.4.2",
                         "pg":  "8.22.0"
                     },
    "devDependencies":  {
                            "@repo/eslint-config":  "workspace:*",
                            "@repo/typescript-config":  "workspace:*",
                            "@types/node":  "^26.1.2",
                            "@types/pg":  "8.20.3",
                            "eslint":  "^9.39.1",
                            "globals":  "^17.8.0",
                            "prisma":  "7.9.1",
                            "tsx":  "^4.23.1",
                            "typescript":  "5.9.2"
                        }
}
