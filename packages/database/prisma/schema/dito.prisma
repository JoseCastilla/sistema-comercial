enum DitoProductType {
  MOBILE
  FIXED
  UNKNOWN
}

enum DitoDeliveryMethod {
  EXPRESS
  REGULAR_24H
  REGULAR_48H
  REGULAR_72H
  UNKNOWN
}

enum DitoParseStatus {
  PARSED
  PARTIAL
  FAILED
}

enum DitoMatchStatus {
  UNMATCHED
  SUGGESTED
  LINKED
  NEEDS_REVIEW
  DISMISSED
}

enum DitoCommercialLinkStatus {
  UNMATCHED
  SUGGESTED
  LINKED
  NEEDS_REVIEW
  DISMISSED
}

enum ApprovalSource {
  ASSUMED_FROM_REGISTRATION
  MANUAL_INTEGRATEL
}

enum DitoOrderStatus {
  OPEN
  SENT
  CLOSED
  CANCELLED
  UNKNOWN
}

enum DitoSentSubstatus {
  NO_STATUS
  ASSIGNED
  SCHEDULED
  NOT_DELIVERED
  REJECTED
  DELIVERED
  UNKNOWN
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  NOT_DELIVERED
  RESCHEDULED
  CANCELLED
}

enum DitoOrderLinkAction {
  LINKED
  UNLINKED
  REASSIGNED
}

enum DitoOrderLinkMethod {
  MANUAL
  SUGGESTED
}

enum DitoOrderCorrectionSource {
  MANUAL_ADMIN
  DITO_BATCH_IMPORT
}

enum DitoImportBatchStatus {
  PREVIEW
  READY
  CONFIRMING
  CONFIRMED
  FAILED
}

enum DitoImportRowClassification {
  NEW_ORDER
  ENRICHMENT
  UNCHANGED
  EXCLUDED
  INVALID
  BLOCKED_IDENTITY
  CONFLICT
}

enum DitoImportRowApplicationStatus {
  PENDING
  APPLIED
  SKIPPED
  FAILED
}

enum DitoOrderCancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DitoOrder {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  eventId           String @map("event_id") @db.VarChar(191)
  sourceFingerprint String @map("source_fingerprint") @db.Char(64)

  productType DitoProductType @default(UNKNOWN) @map("product_type")

  orderCodeRaw             String  @map("order_code_raw") @db.VarChar(100)
  orderCodeNormalized      String  @map("order_code_normalized") @db.VarChar(100)
  legacyOrderCodeSuffix    String? @map("order_code_suffix") @ignore @db.VarChar(10)
  legacyDisplayedOrderCode String? @map("displayed_order_code") @ignore @db.VarChar(100)

  operationRaw        String              @map("operation_raw") @db.VarChar(200)
  commercialOperation CommercialOperation @default(UNKNOWN) @map("commercial_operation")
  carrier             Carrier             @default(UNKNOWN)
  fixedCharge         Decimal?            @map("fixed_charge") @db.Decimal(10, 2)

  salesCode       String? @map("sales_code") @db.VarChar(100)
  billingCycleDay Int?    @map("billing_cycle_day")
  paymentDueDay   Int?    @map("payment_due_day")

  holderFullNameRaw    String       @map("holder_full_name_raw") @db.VarChar(200)
  holderDocumentType   DocumentType @default(UNKNOWN) @map("holder_document_type")
  holderDocumentNumber String       @map("holder_document_number") @db.VarChar(30)

  serviceNumber        String   @map("service_number") @db.VarChar(30)
  deliveryContactPhone String   @map("delivery_contact_phone") @db.VarChar(30)
  deliveryTimeRangeRaw String?  @map("delivery_time_range_raw") @db.VarChar(100)
  deliveryAddress      String?  @map("delivery_address") @db.VarChar(500)
  deliveryReference    String?  @map("delivery_reference") @db.VarChar(500)
  deliveryLatitude     Decimal? @map("delivery_latitude") @db.Decimal(11, 8)
  deliveryLongitude    Decimal? @map("delivery_longitude") @db.Decimal(12, 8)

  deliveryMethod    DitoDeliveryMethod @default(UNKNOWN) @map("delivery_method")
  deliveryMethodRaw String?            @map("delivery_method_raw") @db.VarChar(150)

  department String @db.VarChar(100)
  province   String @db.VarChar(100)
  district   String @db.VarChar(100)

  agentNameRaw             String  @map("agent_name_raw") @db.VarChar(150)
  agentNameNormalized      String? @map("agent_name_normalized") @db.VarChar(150)
  submitterInstallationId  String? @map("submitter_installation_id") @db.Uuid
  submitterEmailRaw        String? @map("submitter_email_raw") @db.VarChar(254)
  submitterEmailNormalized String? @map("submitter_email_normalized") @db.VarChar(254)
  agentUserId              String? @map("agent_user_id") @db.Uuid
  assignedTeamId           String? @map("assigned_team_id") @db.Uuid

  rawSummary        String @map("raw_summary") @db.Text
  additionalDetails Json   @map("additional_details") @db.JsonB

  parseStatus DitoParseStatus @default(PARSED) @map("parse_status")

  commercialLinkStatus DitoCommercialLinkStatus @default(UNMATCHED) @map("commercial_link_status")
  legacyMatchStatus    DitoMatchStatus          @default(UNMATCHED) @map("match_status") @ignore

  status DitoOrderStatus @default(UNKNOWN) @map("status")

  statusRaw String? @map("status_raw") @db.VarChar(100)

  sentSubstatus DitoSentSubstatus? @map("sent_substatus")

  sentSubstatusRaw String? @map("sent_substatus_raw") @db.VarChar(100)

  statusUpdatedAt DateTime? @map("status_updated_at") @db.Timestamptz(3)

  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)

  sentSubstatusUpdatedAt DateTime? @map("sent_substatus_updated_at") @db.Timestamptz(3)

  noStatusDetectedAt DateTime? @map("no_status_detected_at") @db.Timestamptz(3)
  capturedAt         DateTime  @map("captured_at") @db.Timestamptz(3)
  receivedAt         DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  registeredAt       DateTime  @map("registered_at") @db.Timestamptz(3)

  approvedAt     DateTime       @map("approved_at") @db.Timestamptz(3)
  approvalSource ApprovalSource @default(ASSUMED_FROM_REGISTRATION) @map("approval_source")

  approvalUpdatedAt       DateTime? @map("approval_updated_at") @db.Timestamptz(3)
  approvalUpdatedByUserId String?   @map("approval_updated_by_user_id") @db.Uuid

  scheduledDeliveryDate DateTime? @map("scheduled_delivery_date") @db.Date
  deliveryShiftId       String?   @map("delivery_shift_id") @db.Uuid

  deliveryWindowStart DateTime? @map("delivery_window_start") @db.Timestamptz(3)
  deliveryWindowEnd   DateTime? @map("delivery_window_end") @db.Timestamptz(3)
  deliveryDueAt       DateTime? @map("delivery_due_at") @db.Timestamptz(3)

  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")

  deliveryFailureReason String? @map("delivery_failure_reason") @db.VarChar(150)
  deliveryObservation   String? @map("delivery_observation") @db.Text

  commercialServiceId String? @map("commercial_service_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  agent User? @relation("DitoOrderAgent", fields: [agentUserId], references: [id], onDelete: SetNull)

  assignedTeam CommercialTeam? @relation("DitoOrderAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)

  approvalUpdatedBy User? @relation("DitoOrderApprovalUpdatedBy", fields: [approvalUpdatedByUserId], references: [id], onDelete: SetNull)

  closedBy User? @relation("DitoOrderClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  commercialService CommercialService? @relation(fields: [commercialServiceId], references: [id], onDelete: SetNull)

  deliveryShift DeliveryShift? @relation(fields: [deliveryShiftId], references: [id], onDelete: SetNull)

  linkHistory DitoOrderLinkHistory[]

  statusHistory                DitoOrderStatusHistory[]
  escalations                  DeliveryEscalation[]
  ditoOrderAssignmentHistories DitoOrderAssignmentHistory[]
  ditoOrderAssignmentRequests  DitoOrderAssignmentRequest[]
  cancellationRequests         DitoOrderCancellationRequest[]
  corrections                  DitoOrderCorrection[]
  importRows                   DitoImportRow[]
  agrDeliverySnapshot          AgrDeliveryOrderSnapshot?
  recoveryCasesRecovered       RecoveryCase[]            @relation("RecoveryCaseRecoveredOrder")
  recoveryCasesOriginated      RecoveryCase[]            @relation("RecoveryCaseSourceOrder")

  @@unique([organizationId, eventId], map: "dito_orders_org_event_key")
  @@unique([organizationId, orderCodeNormalized], map: "dito_orders_org_order_code_key")
  @@index([organizationId, commercialLinkStatus, capturedAt], map: "dito_orders_org_commercial_link_captured_idx")
  @@index([organizationId, registeredAt], map: "dito_orders_org_registered_idx")
  @@index([organizationId, deliveryStatus, deliveryDueAt], map: "dito_orders_org_delivery_due_idx")
  @@index([organizationId, agentUserId, capturedAt], map: "dito_orders_org_agent_captured_idx")
  @@index([organizationId, agentNameNormalized, capturedAt], map: "dito_orders_org_agent_name_idx")
  @@index([organizationId, submitterInstallationId, capturedAt], map: "dito_orders_org_submitter_installation_idx")
  @@index([organizationId, submitterEmailNormalized, capturedAt], map: "dito_orders_org_submitter_email_idx")
  @@index([commercialServiceId], map: "dito_orders_commercial_service_idx")
  @@index([organizationId, status, registeredAt], map: "dito_orders_org_status_registered_idx")
  @@index([organizationId, status, sentSubstatus, registeredAt], map: "dito_orders_org_status_substatus_registered_idx")
  @@index([organizationId, assignedTeamId, status, registeredAt], map: "dito_orders_org_team_status_registered_idx")
  @@index([organizationId, assignedTeamId, agentUserId, registeredAt], map: "dito_orders_org_team_agent_registered_idx")
  @@index([organizationId, agentUserId, assignedTeamId, registeredAt], map: "dito_orders_org_agent_team_registered_idx")
  @@index([organizationId, closedAt], map: "dito_orders_org_closed_at_idx")
  @@map("dito_orders")
}

model DitoOrderCorrection {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  ditoOrderId       String                    @map("dito_order_id") @db.Uuid
  source            DitoOrderCorrectionSource
  actorUserId       String?                   @map("actor_user_id") @db.Uuid
  ditoImportBatchId String?                   @map("dito_import_batch_id") @db.Uuid
  reason            String                    @db.VarChar(500)
  previousValues    Json                      @map("previous_values") @db.JsonB
  newValues         Json                      @map("new_values") @db.JsonB
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ditoOrder    DitoOrder        @relation(fields: [ditoOrderId], references: [id], onDelete: Cascade)
  actor        User?            @relation("DitoOrderCorrectionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  importBatch  DitoImportBatch? @relation(fields: [ditoImportBatchId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], map: "dito_order_corrections_org_created_idx")
  @@index([ditoOrderId, createdAt], map: "dito_order_corrections_order_created_idx")
  @@index([actorUserId, createdAt], map: "dito_order_corrections_actor_created_idx")
  @@index([ditoImportBatchId, createdAt], map: "dito_order_corrections_batch_created_idx")
  @@map("dito_order_corrections")
}

model DitoAgentIdentity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  externalUsername           String  @map("external_username") @db.VarChar(150)
  externalUsernameNormalized String  @map("external_username_normalized") @db.VarChar(150)
  displayName                String? @map("display_name") @db.VarChar(150)
  userId                     String? @map("user_id") @db.Uuid
  isActive                   Boolean @default(true) @map("is_active")
  isSharedAccount            Boolean @default(false) @map("is_shared_account")

  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation("DitoAgentIdentityUser", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy   User?           @relation("DitoAgentIdentityResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  importRows   DitoImportRow[]

  @@unique([organizationId, externalUsernameNormalized], map: "dito_agent_identities_org_username_key")
  @@index([organizationId, userId, isActive], map: "dito_agent_identities_org_user_active_idx")
  @@map("dito_agent_identities")
}

model DitoImportBatch {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  fileName   String @map("file_name") @db.VarChar(255)
  fileSha256 String @map("file_sha256") @db.Char(64)
  fileSize   Int    @map("file_size")

  parserVersion        String                @map("parser_version") @db.VarChar(30)
  ubigeoCatalogVersion String                @map("ubigeo_catalog_version") @db.VarChar(30)
  sourceSheet          String                @map("source_sheet") @db.VarChar(100)
  headerRow            Int                   @map("header_row")
  status               DitoImportBatchStatus @default(PREVIEW)

  sourceRows     Int @map("source_rows")
  importableRows Int @map("importable_rows")
  excludedRows   Int @map("excluded_rows")
  invalidRows    Int @map("invalid_rows")
  newRows        Int @default(0) @map("new_rows")
  enrichmentRows Int @default(0) @map("enrichment_rows")
  unchangedRows  Int @default(0) @map("unchanged_rows")
  blockedRows    Int @default(0) @map("blocked_rows")
  conflictRows   Int @default(0) @map("conflict_rows")

  uploadedByUserId  String    @map("uploaded_by_user_id") @db.Uuid
  uploadedAt        DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(3)
  failureReason     String?   @map("failure_reason") @db.Text
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy   User                  @relation("DitoImportBatchUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  confirmedBy  User?                 @relation("DitoImportBatchConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  rows         DitoImportRow[]
  corrections  DitoOrderCorrection[]

  @@unique([organizationId, fileSha256], map: "dito_import_batches_org_file_hash_key")
  @@index([organizationId, status, uploadedAt], map: "dito_import_batches_org_status_uploaded_idx")
  @@index([uploadedByUserId, uploadedAt], map: "dito_import_batches_uploader_uploaded_idx")
  @@map("dito_import_batches")
}

model DitoImportRow {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  batchId        String @map("batch_id") @db.Uuid
  sourceRow      Int    @map("source_row")

  classification    DitoImportRowClassification
  applicationStatus DitoImportRowApplicationStatus @default(PENDING) @map("application_status")
  issueCodes        String[]                       @default([]) @map("issue_codes")

  orderCodeNormalized    String? @map("order_code_normalized") @db.VarChar(100)
  displayedOrderCode     String? @map("displayed_order_code") @db.VarChar(100)
  salesCode              String? @map("sales_code") @db.VarChar(100)
  ditoUsernameNormalized String? @map("dito_username_normalized") @db.VarChar(150)

  ditoAgentIdentityId String? @map("dito_agent_identity_id") @db.Uuid
  targetDitoOrderId   String? @map("target_dito_order_id") @db.Uuid

  manualAgentUserId      String?   @map("manual_agent_user_id") @db.Uuid
  manualTeamId           String?   @map("manual_team_id") @db.Uuid
  manualAssignedByUserId String?   @map("manual_assigned_by_user_id") @db.Uuid
  manualAssignedAt       DateTime? @map("manual_assigned_at") @db.Timestamptz(3)
  manualAssignmentReason String?   @map("manual_assignment_reason") @db.VarChar(50)

  parsedData      Json      @map("parsed_data") @db.JsonB
  proposedChanges Json?     @map("proposed_changes") @db.JsonB
  conflicts       Json?     @db.JsonB
  appliedAt       DateTime? @map("applied_at") @db.Timestamptz(3)
  failureReason   String?   @map("failure_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch            DitoImportBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  agentIdentity    DitoAgentIdentity? @relation(fields: [ditoAgentIdentityId], references: [id], onDelete: SetNull)
  targetOrder      DitoOrder?         @relation(fields: [targetDitoOrderId], references: [id], onDelete: SetNull)
  manualAgent      User?              @relation("DitoImportRowManualAgent", fields: [manualAgentUserId], references: [id], onDelete: Restrict)
  manualTeam       CommercialTeam?    @relation("DitoImportRowManualTeam", fields: [manualTeamId], references: [id], onDelete: Restrict)
  manualAssignedBy User?              @relation("DitoImportRowManualAssignedBy", fields: [manualAssignedByUserId], references: [id], onDelete: Restrict)

  @@unique([batchId, sourceRow], map: "dito_import_rows_batch_source_row_key")
  @@index([organizationId, classification, createdAt], map: "dito_import_rows_org_classification_created_idx")
  @@index([organizationId, orderCodeNormalized], map: "dito_import_rows_org_order_code_idx")
  @@index([organizationId, salesCode], map: "dito_import_rows_org_sales_code_idx")
  @@index([ditoAgentIdentityId], map: "dito_import_rows_agent_identity_idx")
  @@index([targetDitoOrderId], map: "dito_import_rows_target_order_idx")
  @@index([manualAgentUserId, manualAssignedAt], map: "dito_import_rows_manual_agent_assigned_idx")
  @@index([manualTeamId, manualAssignedAt], map: "dito_import_rows_manual_team_assigned_idx")
  @@map("dito_import_rows")
}

model DitoOrderStatusHistory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  ditoOrderId    String @map("dito_order_id") @db.Uuid

  previousStatus        DitoOrderStatus    @map("previous_status")
  previousSentSubstatus DitoSentSubstatus? @map("previous_sent_substatus")
  newStatus             DitoOrderStatus    @map("new_status")
  newSentSubstatus      DitoSentSubstatus? @map("new_sent_substatus")

  previousDeliveryStatus DeliveryStatus @map("previous_delivery_status")
  newDeliveryStatus      DeliveryStatus @map("new_delivery_status")

  previousNoStatusDetectedAt DateTime? @map("previous_no_status_detected_at") @db.Timestamptz(3)
  newNoStatusDetectedAt      DateTime? @map("new_no_status_detected_at") @db.Timestamptz(3)

  observation String? @db.Text

  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ditoOrder    DitoOrder    @relation(fields: [ditoOrderId], references: [id], onDelete: Cascade)
  changedBy    User         @relation("DitoOrderStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([ditoOrderId, changedAt], map: "dito_order_status_history_order_changed_idx")
  @@index([organizationId, changedAt], map: "dito_order_status_history_org_changed_idx")
  @@index([changedByUserId, changedAt], map: "dito_order_status_history_user_changed_idx")
  @@map("dito_order_status_history")
}

model DitoOrderCancellationRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  ditoOrderId    String @map("dito_order_id") @db.Uuid

  status DitoOrderCancellationRequestStatus @default(PENDING)
  reason String                             @db.Text

  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)

  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewObservation String?   @map("review_observation") @db.Text

  orderUpdatedAtSnapshot DateTime @map("order_updated_at_snapshot") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ditoOrder    DitoOrder    @relation(fields: [ditoOrderId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("DitoCancellationRequestCreatedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("DitoCancellationRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, requestedAt], map: "dito_cancellation_requests_org_status_requested_idx")
  @@index([ditoOrderId, status], map: "dito_cancellation_requests_order_status_idx")
  @@index([requestedByUserId, requestedAt], map: "dito_cancellation_requests_requester_requested_idx")
  @@index([reviewedByUserId, reviewedAt], map: "dito_cancellation_requests_reviewer_reviewed_idx")
  @@map("dito_order_cancellation_requests")
}

model DitoOrderLinkHistory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  ditoOrderId    String @map("dito_order_id") @db.Uuid

  previousCommercialRequestId String? @map("previous_commercial_request_id") @db.Uuid
  newCommercialRequestId      String? @map("new_commercial_request_id") @db.Uuid

  previousCommercialServiceId String? @map("previous_commercial_service_id") @db.Uuid
  newCommercialServiceId      String? @map("new_commercial_service_id") @db.Uuid

  action DitoOrderLinkAction
  method DitoOrderLinkMethod

  suggestionScore Int?    @map("suggestion_score")
  reason          String? @db.Text

  performedByUserId String   @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime @default(now()) @map("performed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ditoOrder    DitoOrder    @relation(fields: [ditoOrderId], references: [id], onDelete: Restrict)

  previousCommercialRequest CommercialRequest? @relation("DitoOrderLinkPreviousRequest", fields: [previousCommercialRequestId], references: [id], onDelete: SetNull)
  newCommercialRequest      CommercialRequest? @relation("DitoOrderLinkNewRequest", fields: [newCommercialRequestId], references: [id], onDelete: SetNull)

  previousCommercialService CommercialService? @relation("DitoOrderLinkPreviousService", fields: [previousCommercialServiceId], references: [id], onDelete: SetNull)
  newCommercialService      CommercialService? @relation("DitoOrderLinkNewService", fields: [newCommercialServiceId], references: [id], onDelete: SetNull)

  performedBy User @relation("DitoOrderLinkPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([ditoOrderId, performedAt], map: "dito_order_link_history_order_performed_idx")
  @@index([organizationId, performedAt], map: "dito_order_link_history_org_performed_idx")
  @@index([performedByUserId, performedAt], map: "dito_order_link_history_user_performed_idx")
  @@map("dito_order_link_history")
}
