generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  ADMIN
  SUPERVISOR
  AGENT
  BACKOFFICE
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  DISABLED
  ERROR
}

enum WebhookSource {
  GHL_N8N
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
}

model Organization {
  id       String             @id @default(uuid()) @db.Uuid
  name     String             @db.VarChar(150)
  slug     String             @unique @db.VarChar(100)
  timezone String             @default("America/Lima") @db.VarChar(64)
  status   OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members         OrganizationMember[]
  ghlIntegrations GhlIntegration[]
  webhookEvents   WebhookEvent[]

  contacts                  Contact[]
  contactExternalIdentities ContactExternalIdentity[]
  commercialRequests        CommercialRequest[]
  commercialServices        CommercialService[]

  ditoOrders           DitoOrder[]
  ditoOrderLinkHistory DitoOrderLinkHistory[]

  ditoOrderStatusHistory        DitoOrderStatusHistory[]
  ditoOrderCancellationRequests DitoOrderCancellationRequest[]
  deliveryShifts                DeliveryShift[]
  deliveryEscalations           DeliveryEscalation[]

  agentAliases                 AgentAlias[]
  commercialTeams              CommercialTeam[]
  commercialTeamMembers        CommercialTeamMember[]
  commercialTeamAuditLogs      CommercialTeamAuditLog[]
  ditoOrderAssignmentHistories DitoOrderAssignmentHistory[]
  ditoOrderAssignmentRequests  DitoOrderAssignmentRequest[]
  ditoOrderCorrections         DitoOrderCorrection[]
  ditoAgentIdentities          DitoAgentIdentity[]
  ditoImportBatches            DitoImportBatch[]
  ditoImportRows               DitoImportRow[]
  agrDeliveryIntegrations      AgrDeliveryIntegration[]
  agrDeliverySyncRuns          AgrDeliverySyncRun[]
  agrDeliveryOrderSnapshots    AgrDeliveryOrderSnapshot[]
  agrDeliveryOrderHistory      AgrDeliveryOrderHistory[]

  recoveryEligibilityConfigs RecoveryEligibilityConfig[]
  recoveryBaseBatches        RecoveryBaseBatch[]
  recoveryBaseRecords        RecoveryBaseRecord[]
  recoveryCases              RecoveryCase[]
  recoveryCaseServices       RecoveryCaseService[]
  recoveryCasePhones         RecoveryCasePhone[]
  recoveryCaseSightings      RecoveryCaseSighting[]
  recoveryCaseEvents         RecoveryCaseEvent[]
  recoveryPortabilityBatches RecoveryPortabilityBatch[]
  recoveryPortabilityResults RecoveryPortabilityResult[]

  dniPersonSnapshots DniPersonSnapshot[]
  dniLookupEvents    DniLookupEvent[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String     @db.VarChar(150)
  email              String     @unique @db.VarChar(254)
  emailVerified      Boolean    @default(false) @map("email_verified")
  image              String?    @db.Text
  legacyPasswordHash String?    @map("password_hash") @ignore @db.VarChar(255)
  status             UserStatus @default(INVITED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizationMember[]

  sessions Session[]
  accounts Account[]

  commercialRequestsAsAgent CommercialRequest[] @relation("CommercialRequestAgent")

  ditoOrdersAsAgent         DitoOrder[]            @relation("DitoOrderAgent")
  ditoOrdersApprovalUpdated DitoOrder[]            @relation("DitoOrderApprovalUpdatedBy")
  ditoOrdersClosed          DitoOrder[]            @relation("DitoOrderClosedBy")
  ditoOrderLinksPerformed   DitoOrderLinkHistory[] @relation("DitoOrderLinkPerformedBy")

  ditoOrderStatusChanges           DitoOrderStatusHistory[]       @relation("DitoOrderStatusChangedBy")
  ditoCancellationRequestsCreated  DitoOrderCancellationRequest[] @relation("DitoCancellationRequestCreatedBy")
  ditoCancellationRequestsReviewed DitoOrderCancellationRequest[] @relation("DitoCancellationRequestReviewedBy")
  deliveryEscalationsCreated       DeliveryEscalation[]           @relation("DeliveryEscalationCreatedBy")
  deliveryEscalationsAcknowledged  DeliveryEscalation[]           @relation("DeliveryEscalationAcknowledgedBy")
  deliveryEscalationsResolved      DeliveryEscalation[]           @relation("DeliveryEscalationResolvedBy")
  deliveryEscalationsTdpEscalated  DeliveryEscalation[]           @relation("DeliveryEscalationTdpEscalatedBy")

  agentAliases AgentAlias[]

  commercialTeamsCreated         CommercialTeam[]         @relation("CommercialTeamCreatedBy")
  commercialTeamMemberships      CommercialTeamMember[]   @relation("CommercialTeamMemberUser")
  commercialTeamMembershipsGiven CommercialTeamMember[]   @relation("CommercialTeamMemberAssignedBy")
  commercialTeamAuditsPerformed  CommercialTeamAuditLog[] @relation("CommercialTeamAuditActor")
  commercialTeamAuditsAsTarget   CommercialTeamAuditLog[] @relation("CommercialTeamAuditTarget")

  ditoAssignmentsAsPreviousAgent DitoOrderAssignmentHistory[] @relation("DitoAssignmentPreviousAgent")
  ditoAssignmentsAsNewAgent      DitoOrderAssignmentHistory[] @relation("DitoAssignmentNewAgent")
  ditoAssignmentsPerformed       DitoOrderAssignmentHistory[] @relation("DitoAssignmentPerformedBy")

  ditoAssignmentRequestsCreated        DitoOrderAssignmentRequest[] @relation("DitoAssignmentRequestCreatedBy")
  ditoAssignmentRequestsSuggestedAgent DitoOrderAssignmentRequest[] @relation("DitoAssignmentRequestSuggestedAgent")
  ditoAssignmentRequestsReviewed       DitoOrderAssignmentRequest[] @relation("DitoAssignmentRequestReviewedBy")
  ditoOrderCorrectionsPerformed        DitoOrderCorrection[]        @relation("DitoOrderCorrectionActor")
  ditoAgentIdentities                  DitoAgentIdentity[]          @relation("DitoAgentIdentityUser")
  ditoAgentIdentityResolutions         DitoAgentIdentity[]          @relation("DitoAgentIdentityResolvedBy")
  ditoImportBatchesUploaded            DitoImportBatch[]            @relation("DitoImportBatchUploadedBy")
  ditoImportBatchesConfirmed           DitoImportBatch[]            @relation("DitoImportBatchConfirmedBy")
  ditoImportRowsAsManualAgent          DitoImportRow[]              @relation("DitoImportRowManualAgent")
  ditoImportRowAssignmentsPerformed    DitoImportRow[]              @relation("DitoImportRowManualAssignedBy")
  agrDeliveryCredentialsUpdated        AgrDeliveryIntegration[]     @relation("AgrDeliveryCredentialUpdatedBy")

  recoveryConfigsCreated         RecoveryEligibilityConfig[] @relation("RecoveryConfigCreatedBy")
  recoveryBatchesUploaded        RecoveryBaseBatch[]         @relation("RecoveryBatchUploadedBy")
  recoveryBatchesConfirmed       RecoveryBaseBatch[]         @relation("RecoveryBatchConfirmedBy")
  recoveryCasesAssigned          RecoveryCase[]              @relation("RecoveryCaseAssignedUser")
  recoveryCasesResolved          RecoveryCase[]              @relation("RecoveryCaseResolvedBy")
  recoveryCasesSensitiveRevealed RecoveryCase[]              @relation("RecoveryCaseSensitiveRevealedBy")
  recoveryCaseEventsPerformed    RecoveryCaseEvent[]         @relation("RecoveryCaseEventActor")
  recoveryPortabilityUploaded    RecoveryPortabilityBatch[]  @relation("RecoveryPortabilityUploadedBy")

  dniLookupEventsPerformed DniLookupEvent[] @relation("DniLookupActor")

  @@map("users")
}

model OrganizationMember {
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model GhlIntegration {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String?           @map("company_id") @db.VarChar(100)
  locationId     String            @map("location_id") @db.VarChar(100)
  locationName   String            @map("location_name") @db.VarChar(150)
  status         IntegrationStatus @default(PENDING)

  webhookSecretHash String? @map("webhook_secret_hash") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]

  contactExternalIdentities ContactExternalIdentity[]
  commercialRequests        CommercialRequest[]

  @@unique([organizationId, locationId])
  @@index([organizationId, status])
  @@map("ghl_integrations")
}

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  organizationId   String @map("organization_id") @db.Uuid
  ghlIntegrationId String @map("ghl_integration_id") @db.Uuid

  source          WebhookSource
  locationId      String        @map("location_id") @db.VarChar(100)
  externalEventId String        @map("external_event_id") @db.VarChar(191)
  eventType       String        @map("event_type") @db.VarChar(100)
  envelopeVersion String        @map("envelope_version") @db.VarChar(20)
  snapshotType    String?       @map("snapshot_type") @db.VarChar(50)

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  status             WebhookProcessingStatus @default(RECEIVED)
  processingAttempts Int                     @default(0) @map("processing_attempts")
  processedAt        DateTime?               @map("processed_at") @db.Timestamptz(3)
  lastError          String?                 @map("last_error") @db.Text

  payload Json @db.JsonB

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ghlIntegration GhlIntegration @relation(fields: [ghlIntegrationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, source, locationId, externalEventId], map: "webhook_events_org_source_location_event_key")
  @@index([organizationId, status, receivedAt], map: "webhook_events_org_status_received_idx")
  @@index([ghlIntegrationId, status], map: "webhook_events_integration_status_idx")
  @@index([occurredAt], map: "webhook_events_occurred_at_idx")
  @@map("webhook_events")
}
