{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "api",
        "start:dev"
      ],
      "port": 3001
    },
    {
      "name": "crm",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "crm",
        "dev"
      ],
      "port": 3200
    }
  ]
}
