{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "DITO_WEBHOOK_SECRET",
    "DITO_WEBHOOK_ORGANIZATION_SLUG",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NODE_ENV",
    "DITO_IMPORT_API_URL",
    "DITO_IMPORT_INTERNAL_SECRET",
    "AGR_DELIVERY_ENCRYPTION_KEY",
    "RECOVERY_BASE_INTERNAL_SECRET",
    "DNI_LOOKUP_API_TOKEN",
    "DNI_LOOKUP_API_URL",
    "HOST",
    "PORT",
    "APP_VERSION",
    "BUSINESS_TIMEZONE",
    "MAINTENANCE_INTERNAL_SECRET",
    "WEB_INTERNAL_URL",
    "API_INTERNAL_URL",
    "MAINTENANCE_INTERVAL_MINUTES",
    "CRM_ENCRYPTION_KEY",
    "CRM_STORAGE_DIR",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_CONFIG_ID",
    "META_GRAPH_API_VERSION",
    "META_WEBHOOK_VERIFY_TOKEN",
    "ANTHROPIC_API_KEY",
    "AI_USD_TO_PEN",
    "BROADCAST_USD_TO_PEN",
    "NEXT_RUNTIME"
  ]
}
